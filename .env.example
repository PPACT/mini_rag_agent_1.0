# ===== LLM（DeepSeek 云 API）=====
# 必填：DeepSeek API key（未填时 /chat 返回 503）
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== Embedding（本地 Ollama）=====
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16

# ===== PostgreSQL + pgvector =====
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_demo_pwd
POSTGRES_DB=rag_demo
DATABASE_URL=postgresql://rag:rag_demo_pwd@localhost:15432/rag_demo

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== 向量库开关（pgvector | milvus）=====
VECTOR_STORE=pgvector

# ===== 应用 =====
UPLOAD_DIR=./data/uploads
# 上传文件大小上限（字节，默认 50MB）
MAX_UPLOAD_SIZE=52428800
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
CACHE_TTL=3600

# ===== 鉴权（演示 token，见 src/auth/deps.py 的 DEMO_USERS）=====
# demo-it-token     -> 张三 IT 密级3
# demo-hr-token     -> 李四 HR 密级2
# demo-public-token -> 访客 公开 密级0
