# ===== LLM（DeepSeek 云 API）=====
# 必填：DeepSeek API key（未填时 /chat 返回 503）
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== Embedding（本地 Ollama）=====
# 注意：Ollama 端口若落在 Windows 保留段（动态变化）会绑定失败，用 OLLAMA_HOST 换端口
OLLAMA_BASE_URL=http://localhost:11451
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16

# ===== PostgreSQL + pgvector =====
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_demo_pwd
POSTGRES_DB=rag_demo
DATABASE_URL=postgresql://rag:rag_demo_pwd@localhost:15432/rag_demo

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== 检索策略开关 =====
VECTOR_STORE=pgvector
# 混合检索（向量 + 全文检索 RRF 融合）：兜底"精确词"查询（缩写/编号/型号）
HYBRID_SEARCH_ENABLED=true
# HNSW 检索深度：pgvector 默认 40 会损失约 12% 召回（实测），100 仅多 ~3ms
HNSW_EF_SEARCH=100
# 多查询扩展（LLM 生成变体后多路检索）
QUERY_REWRITE_ENABLED=true
# 两段式精排（粗排召回 rerank_candidates 条 → 精排取 top_k）
RERANK_ENABLED=true
# 歧义判定（候选互相矛盾时反问而非硬答）
AMBIGUITY_CHECK_ENABLED=true

# ===== 应用 =====
UPLOAD_DIR=./data/uploads
# 上传文件大小上限（字节，默认 50MB）
MAX_UPLOAD_SIZE=52428800
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
CACHE_TTL=3600

# ===== 鉴权（演示 token，见 src/auth/deps.py 的 DEMO_USERS）=====
# demo-it-token     -> 张三 IT 密级3
# demo-hr-token     -> 李四 HR 密级2
# demo-public-token -> 访客 公开 密级0
