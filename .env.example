# ===== LLM（DeepSeek 云 API）=====
# 必填：DeepSeek API key（未填时 /chat 返回 503）
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 思考链开关：deepseek-v4-flash 是**推理模型**，思考(reasoning_content)与结论(content)
# **共用同一份 max_tokens 预算**。思考一旦吃满，content 就是空的 → 调用方拿到空串后
# **静默降级**（歧义判定→误判"不歧义"造成漏报；LLM 精排→退回粗排顺序等于空转）。故默认关闭。
# ⚠️ 真要开启时注意：DeepSeek 的 reasoning_effort **除 "none" 外都是"开启思考"**，
#    传 "low" 不是"少思考"而是"开启思考"，别指望用它降低思考量。
LLM_THINKING_ENABLED=false

# ===== Embedding（本地 Ollama）=====
# 注意：Ollama 端口若落在 Windows 保留段（动态变化）会绑定失败，用 OLLAMA_HOST 换端口
OLLAMA_BASE_URL=http://localhost:11451
# embedding 模型的空闲驻留时长（随请求下发）。Ollama 默认 5m，届时会卸载模型，
# 于是"隔一会儿再问"的第一个请求要多等约 2.5 秒重载。折中取 30m：
# 短暂离开回来无需等待，长时间闲置仍释放显存（bge-m3 约 660MB）。
# 可填 Go duration（"30m"/"1h"）或秒数；-1 = 常驻不卸载（用显存换延迟）。
OLLAMA_KEEP_ALIVE=30m
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16

# ===== PostgreSQL + pgvector（**两库分离**：真实 / 压测）=====
# 为什么分两库：合成评测语料含 624 篇"近重复干扰"，与真实文档同库会淹没真实答案。
# 详见 docs/交流区.md §1.6。两库是**两个容器**，压测库按需启动：
#   docker compose up -d                      # 日常：只起真实库 + Redis
#   docker compose --profile stress up -d     # 压测/评测：多起压测库
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_demo_pwd
# 真实业务库（/chat 固定用它）
POSTGRES_DB=rag_real
DATABASE_URL=postgresql://rag:rag_demo_pwd@localhost:15432/rag_real
# 压测库（合成语料；端口与真实库分开）
POSTGRES_STRESS_PORT=15433
POSTGRES_STRESS_DB=rag_stress
DATABASE_URL_STRESS=postgresql://rag:rag_demo_pwd@localhost:15433/rag_stress

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== 检索策略开关 =====
VECTOR_STORE=pgvector
# 公司级文档的部门标记（全员可见）：用户可见范围 = 公司级 + 本部门
COMPANY_SCOPE=公司
# 混合检索（向量 + 全文检索 RRF 融合）：兜底"精确词"查询（缩写/编号/型号）
HYBRID_SEARCH_ENABLED=true
# HNSW 检索深度：pgvector 默认 40 会损失约 12% 召回（实测），100 仅多 ~3ms
HNSW_EF_SEARCH=100
# 多查询扩展（LLM 生成变体后多路检索）
# ⚠️ 实测（清晰题 80 条）：单独使用零增益；与精排组合时**关掉它反而更好**
#    （Recall@1 0.800→0.850、MRR 0.872→0.896），且它多一级 LLM 调用会增方差。
#    故默认关闭，保留开关备用。
QUERY_REWRITE_ENABLED=false
# 两段式精排（粗排召回 rerank_candidates 条 → 精排取 top_k）
RERANK_ENABLED=true
# 粗排召回条数（送进精排的候选数）：调大更全、更慢
RERANK_CANDIDATES=20
# 精排后端：local = 本地 cross-encoder（默认，确定性、无网络依赖）
#           llm   = 云端 LLM 兜底（本地模型不可用时才用；不要在推理模型上开思考链）
RERANK_BACKEND=local
# 本地 cross-encoder 模型名与设备（留空 = 自动，有 CUDA 用 cuda）
RERANK_LOCAL_MODEL=BAAI/bge-reranker-base
RERANK_LOCAL_DEVICE=
# 歧义判定（候选互相矛盾时反问而非硬答）
AMBIGUITY_CHECK_ENABLED=true

# ===== 应用 =====
UPLOAD_DIR=./data/uploads
# 上传文件大小上限（字节，默认 50MB）
MAX_UPLOAD_SIZE=52428800
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
CACHE_TTL=3600

# ===== 鉴权（演示 token，见 src/auth/deps.py 的 DEMO_USERS）=====
# demo-it-token     -> 张三 IT 密级3
# demo-hr-token     -> 李四 HR 密级2
# demo-public-token -> 访客 公开 密级0
